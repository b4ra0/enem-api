# Banco de dados usado apenas para registrar logs de acesso.
# Opcional: sem DATABASE_URL o log de requisições é desativado.
DATABASE_URL="postgresql://user:password@localhost:5432/enem-api"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/enem-api"

# Rate limit (por rota, por IP). Padrão: 10 requisições a cada 10 segundos.
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_MS=10000
# RATE_LIMIT_DISABLED=true
